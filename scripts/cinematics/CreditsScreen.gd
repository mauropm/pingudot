extends Control
class_name CreditsScreen

signal finished

var _scroll: VBoxContainer
var _t := 0.0
var _done := false

const CREDITS := [
	"PINGUDOT",
	"MISSION ACCOMPLISHED",
	"",
	"-- A LOST 1994 BUILD --",
	"",
	"PINGU",
	"The last honest sysadmin.",
	"",
	"THE CTO OF EVERYTHING",
	"Defeated. Board unpleased.",
	"",
	"BSDemon",
	"Still compiling. Still complaining.",
	"",
	"LITTLE BILL",
	"Acquired. Rebranded. Delisted.",
	"",
	"THE GPL HIPSTER",
	"Claims he wrote this credits list in 1998.",
	"",
	"-- DEVELOPED IN --",
	"Godot Engine 4.x",
	"All sprites generated by local pixel-forgery.",
	"All music synthesized in a shed with numpy.",
	"",
	"-- SATIRE DISCLAIMER --",
	"Penguins do not in fact hold root.",
	"Your startup was not a dungeon. Probably.",
	"",
	"TRUST IS NOT A FEATURE.",
	"IT IS THE FLIGHT PLAN.",
	"",
	"SEE YOU IN OAXACA.",
]


func _ready() -> void:
	var bg := ColorRect.new()
	bg.color = Color("07050f")
	bg.set_anchors_preset(PRESET_FULL_RECT)
	add_child(bg)
	var stars := TextureRect.new()
	stars.texture = load("res://assets/environments/backgrounds/area3_bg.png")
	stars.modulate = Color(0.5, 0.5, 0.8, 0.35)
	stars.stretch_mode = TextureRect.STRETCH_TILE
	stars.set_anchors_preset(PRESET_FULL_RECT)
	add_child(stars)
	_scroll = VBoxContainer.new()
	_scroll.position = Vector2(0, 216)
	_scroll.size = Vector2(384, 600)
	_scroll.add_theme_constant_override("separation", 4)
	add_child(_scroll)
	for i in CREDITS.size():
		var txt := str(CREDITS[i])
		var big := txt == "PINGUDOT" or txt == "MISSION ACCOMPLISHED"
		var head := txt.begins_with("--")
		var col := Color("f7e94b") if big else (Color("2de3ff") if head else Color("d0d0d8"))
		var l := UISkin.label(txt, 16 if big else 8, col)
		l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		l.size = Vector2(384, 12 if not big else 20)
		_scroll.add_child(l)
	AudioDirector.play_music("credits", 0.8)


func _process(delta: float) -> void:
	if _done:
		return
	_t += delta
	_scroll.position.y -= 14.0 * delta
	if _scroll.position.y < -(_scroll.get_combined_minimum_size().y + 24):
		_finish()


func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and not event.echo:
		_finish()
		get_viewport().set_input_as_handled()


func _finish() -> void:
	if _done:
		return
	_done = true
	finished.emit()
