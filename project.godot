[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemies"
2d_physics/layer_4="PlayerHitbox"
2d_physics/layer_5="EnemyHitbox"
2d_physics/layer_6="Pickups"
2d_physics/layer_7="Interactables"
2d_physics/layer_8="Hazards"

[rendering]

renderer/rendering_method="gl_compatibility"
textures/canvas_items/default_filter=0
textures/vram_compression/import_etc2_astc=false
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
anti_aliasing/quality/msaa_2d=0

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[debug]

gdscript/warnings/inference_on_variant=1
gdscript/warnings/untyped_declaration=1
gdscript/warnings/narrowing_conversion=1
gdscript/warnings/integer_division=1
