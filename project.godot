; Engine configuration file.
; PINGUDOT — a 16-bit action RPG roguelite. Godot 4.x

config_version=5

[application]

config/name="PINGUDOT"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/systems/EventBus.gd"
FX="*res://scripts/systems/FX.gd"
SaveSystem="*res://scripts/systems/SaveSystem.gd"
AudioDirector="*res://scripts/systems/AudioDirector.gd"
ItemRegistry="*res://scripts/systems/ItemRegistry.gd"
AbilityRegistry="*res://scripts/systems/AbilityRegistry.gd"
CharacterRegistry="*res://scripts/systems/CharacterRegistry.gd"
GameState="*res://scripts/systems/GameState.gd"
AchievementManager="*res://scripts/systems/AchievementManager.gd"
DialogueDB="*res://scripts/systems/DialogueDB.gd"
Main="*res://scripts/systems/Main.gd"

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/window_width_override=1536
window/size/window_height_override=864
window/stretch/mode="viewport"
window/stretch/scale_mode=1

